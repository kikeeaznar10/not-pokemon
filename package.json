{
  "name": "flexymon",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsx tools/make-atlas.ts && tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "npm install && npm run build && vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "placeholders": "tsx tools/make-placeholders.ts",
    "test-map": "tsx tools/make-test-map.ts",
    "world": "tsx tools/make-world.ts",
    "atlas": "tsx tools/make-atlas.ts",
    "offline": "npm run build && tsx tools/make-offline.ts",
    "art": "tsx tools/make-art.ts"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
